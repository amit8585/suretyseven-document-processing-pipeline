FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --omit=dev

COPY src ./src
COPY migrations ./migrations
RUN mkdir -p uploads

ENV NODE_ENV=production

CMD ["sh", "-c", "until node src/db/migrate.js; do echo 'waiting for postgres'; sleep 2; done; node src/workers/index.js"]
