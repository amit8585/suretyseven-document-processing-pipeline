# Backend
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://surety:surety@localhost:5432/suretyseven

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Mock processor: SUCCESS | TIMEOUT | ERROR | INVALID_RESULT
PROCESSOR_SCENARIO=SUCCESS
PROCESSOR_DELAY_MS=400

# Retry
MAX_PROCESSING_ATTEMPTS=3
RETRY_BACKOFF_MS=1000

# Frontend (Vite)
VITE_API_URL=
